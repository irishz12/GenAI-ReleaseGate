# Copy to .env and fill in real values. Never commit .env itself (it's gitignored).
#
# Model IDs, params, and pricing are NOT here — they belong in config/models.yaml
# (see its `bedrock_mantle:` section). This file holds connection secrets only.

# Bedrock Mantle is exposed as an OpenAI-compatible chat-completions endpoint —
# providers/bedrock_mantle.py talks to it with a plain bearer token, not AWS SigV4.
MANTLE_BASE_URL=
MANTLE_API_KEY=
# MANTLE_TIMEOUT_SECONDS=30
# MANTLE_MAX_RETRIES=3

# No live Mantle deployment? BedrockMantleClient falls back to OPENAI_API_KEY /
# https://api.openai.com/v1 if MANTLE_API_KEY / MANTLE_BASE_URL aren't set — useful for
# proving the client works against a real OpenAI-compatible endpoint in the meantime.
OPENAI_API_KEY=

# Local results store
EVALGUARD_DB_PATH=artifacts/eval.db

# Cost circuit breaker (Phase 3+)
EVALGUARD_MAX_SPEND_USD=5.00
